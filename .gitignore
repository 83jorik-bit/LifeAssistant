# Секреты — никогда не коммитить
local.properties

# Релизный ключ подписи и его base64. Утечка означает, что кто угодно
# сможет выпустить обновление приложения от вашего имени.
# (debug-ключ в папке keystore/ коммитится намеренно — он не секретный.)
/release.keystore
/release.keystore.base64.txt
*.jks

