<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Уведомление о превышении лимита бюджета. С Android 13 это разрешение запрашивается
         во время работы приложения, а не выдаётся автоматически при установке. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Банковские SMS о списаниях. Только новые входящие (RECEIVE_SMS), а не весь
         архив переписки (READ_SMS). В RuStore — «чувствительное» разрешение:
         требует декларации в консоли и объяснения в интерфейсе. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Камера: сканирование QR с чеков и QR для оплаты по СБП.
         Запрашивается в момент открытия сканера, а не при старте приложения. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Начиная с Android 11 приложение по умолчанию "не видит" другие пакеты, и попытка
        открыть ссылку может не разрешиться в интент. В логе это выглядело так:
        AppsFilter: com.lifenavigator.app -> ru.yandex.yandexmaps BLOCKED.
        Здесь объявляем, какие схемы мы намерены открывать.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="yandexmaps" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="ymapsbm1" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="yandexnavi" />
        </intent>
        <!-- Навигатор запускаем с явным setPackage, поэтому нужен и сам пакет. -->
        <package android:name="ru.yandex.yandexnavi" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>


    <application
        android:name=".LifeNavigatorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeNavigator">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LifeNavigator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Возврат из браузера после входа через Яндекс ID. Этот адрес
                (lifenavigator://auth/yandex) указывается в кабинете Яндекса вручную.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifenavigator" android:host="auth" />
            </intent-filter>

            <!--
                Возврат из браузера после входа через VK ID. В отличие от Яндекса,
                этот адрес нигде в кабинете VK не указывается — он фиксированный и
                вычисляется автоматически как vk{clientId}://vk.ru/blank.html.
                Схема подставляется на сборке из VK_CLIENT_ID, см. app/build.gradle.kts.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${vkRedirectScheme}"
                    android:host="vk.ru"
                    android:path="/blank.html" />
            </intent-filter>
        </activity>

        <!--
            Служба чтения банковских уведомлений. Включается пользователем вручную
            в системных настройках: разрешение BIND_NOTIFICATION_LISTENER_SERVICE
            выдаётся только так, запросить его диалогом изнутри приложения нельзя.
        -->
        <service
            android:name=".data.notifications.BankNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".data.notifications.BankSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider для экспорта бюджета в CSV: с Android 7 нельзя передавать
             другим приложениям голый file:// URI, только через провайдер. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
