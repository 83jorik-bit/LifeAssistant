# Скопируйте в .env и заполните.

PORT=3000

# Секрет для подписи сессионных токенов. Сгенерировать: openssl rand -hex 32
# ВАЖНО: смена этого значения разлогинит всех пользователей разом — все выданные
# токены перестанут проходить проверку.
JWT_SECRET=

# Куда сохраняется файл базы данных (SQLite). В Docker — путь смонтированного тома.
DB_DIR=/data
