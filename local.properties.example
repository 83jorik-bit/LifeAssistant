# Copy to local.properties on your development computer; Git ignores that file.
# Any value compiled into Android BuildConfig or resources can be extracted from the APK.
# Never put server-only credentials or release signing passwords into mobile configuration.

# MapKit mobile SDK key: restrict it in the provider console to this app/package where possible.
MAPKIT_API_KEY=your-restricted-mapkit-key

# Yandex Rasp API credentials belong on the backend; the mobile client is disabled
# until a secure proxy is configured.

# OAuth client IDs are public application identifiers, not client secrets.
YANDEX_CLIENT_ID=
VK_CLIENT_ID=
YANDEX_REDIRECT_URI=

# Optional backend URL. Keep server API credentials on the backend only.
BACKEND_BASE_URL=

# YandexGPT folder/catalog ID is not a credential.
YANDEX_GPT_FOLDER_ID=

# Release signing; keep the file and passwords outside Git.
RELEASE_STORE_FILE=/absolute/path/to/release.keystore
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=lifenavigator
RELEASE_KEY_PASSWORD=
