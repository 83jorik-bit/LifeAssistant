# Copy to local.properties on your own computer. local.properties is ignored by Git.
# Values placed into Android BuildConfig can be extracted from the APK; do not put
# server-only API keys or signing passwords in Android app configuration.
MAPKIT_API_KEY=your-restricted-mapkit-key
RASP_API_KEY=your-yandex-rasp-key

# OAuth client IDs are identifiers, not client secrets.
YANDEX_CLIENT_ID=
VK_CLIENT_ID=
YANDEX_REDIRECT_URI=

# Optional backend base URL. Server-side API credentials belong on the server only.
BACKEND_BASE_URL=

# YandexGPT folder/catalog ID is not a credential.
YANDEX_GPT_FOLDER_ID=

# Local release signing: keep the keystore and passwords outside Git.
# Prefer setting RELEASE_STORE_FILE, RELEASE_STORE_PASSWORD, RELEASE_KEY_ALIAS,
# and RELEASE_KEY_PASSWORD as environment variables.
RELEASE_STORE_FILE=/absolute/path/to/release.keystore
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=lifenavigator
RELEASE_KEY_PASSWORD=
