# Copy to .env on the server. Never commit actual values.
PORT=3000
DB_PATH=./data/app.db

# Required for issuing and verifying app sessions.
JWT_SECRET=replace-with-a-long-random-secret

# YandexGPT credentials are server-side only; never set these in Android local.properties.
YANDEX_GPT_API_KEY=replace-with-yandex-cloud-api-key
YANDEX_GPT_FOLDER_ID=your-yandex-cloud-folder-id
